# ── Required ─────────────────────────────────────────────────────────────────
# Dashboard → API keys. Needs trade permission.
TICKERALL_API_KEY=ta_live_xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → the account this service trades. Start with a DEMO account.
TICKERALL_ACCOUNT_ID=acc_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Risk ─────────────────────────────────────────────────────────────────────
# Percent of account BALANCE risked per trade when the alert does not say.
RISK_PERCENT=1

# ── Safety ───────────────────────────────────────────────────────────────────
# Shared secret. Set it. Without it, anyone who learns the URL can trade your
# account — include the same value as "secret" in the alert JSON.
WEBHOOK_SECRET=

# Must be the exact string "true" to permit trading a LIVE account.
# Anything else — unset, "false", "1", "yes" — keeps this demo-only.
ALLOW_LIVE=false

# ── Optional ─────────────────────────────────────────────────────────────────
PORT=8080
# Override only for staging / self-hosted.
# TICKERALL_BASE_URL=https://api.tickerall.com
