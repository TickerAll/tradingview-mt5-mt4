# ── Required ─────────────────────────────────────────────────────────────────
# Dashboard → API keys. Needs trade permission.
TICKERALL_API_KEY=ta_live_xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → the account to manage. Start with a DEMO account.
TICKERALL_ACCOUNT_ID=acc_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Behaviour ────────────────────────────────────────────────────────────────
# Act once a position is this many multiples of its ORIGINAL stop distance in
# profit. 1 = at +1R, i.e. the trade has made what it was risking.
TRIGGER_R=1
# Fraction of the position to close at the trigger. 0.5 = half. 0 disables the
# partial and leaves only the break-even move.
PARTIAL_FRACTION=0.5
# Points BEYOND entry to place the break-even stop, to cover commission/swap.
# 0 puts it exactly at entry.
BREAK_EVEN_OFFSET_POINTS=0
# Comma-separated broker symbol names to manage. Empty = every open position.
SYMBOLS=
# How often to check. Positions move slower than ticks; 10s is plenty.
POLL_SECONDS=10

# ── Safety ───────────────────────────────────────────────────────────────────
# "true" logs every decision and sends nothing. Run this first.
DRY_RUN=true

# Must be the exact string "true" to permit managing a LIVE account.
# Anything else — unset, "false", "1", "yes" — keeps this demo-only.
ALLOW_LIVE=false

# ── Optional ─────────────────────────────────────────────────────────────────
# TICKERALL_BASE_URL=https://api.tickerall.com
