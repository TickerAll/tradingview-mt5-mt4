//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// TickerAll — TradingView → MT5 alert bridge (INDICATOR template)
//
// Same idea as the strategy template, as a study. Use this when you want an alert
// off an indicator condition rather than a backtestable strategy.
// See https://github.com/TickerAll/tradingview-mt5-mt4
//
// HOW TO WIRE IT UP
//   1. Add this script to your chart and tune the inputs.
//   2. Create an alert. Condition: this indicator, "Any alert() function call".
//   3. Webhook URL: paste your TickerAll webhook URL. Leave the Message empty —
//      the alert() calls below carry the JSON.
// ─────────────────────────────────────────────────────────────────────────────
indicator("TickerAll Bridge — EMA cross (study)", overlay = true)

// ── Inputs ──
symbol    = input.string("BTCUSD", "Broker symbol")
lots      = input.float(0.10, "Lot size", minval = 0.01, step = 0.01)
fastLen   = input.int(9,  "Fast EMA")
slowLen   = input.int(21, "Slow EMA")
useSecret = input.bool(false, "Send a secret")
secret    = input.string("", "Secret (if your webhook requires one)")

// ── Signals (swap for your own) ──
fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
goLong  = ta.crossover(fast, slow)
goShort = ta.crossunder(fast, slow)

plot(fast, "Fast EMA", color.new(color.aqua, 0))
plot(slow, "Slow EMA", color.new(color.orange, 0))
plotshape(goLong,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(goShort, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.tiny)

// ── Build the webhook JSON ──
// secretPart is empty unless you turn on "Send a secret" — then it appends
// ,"secret":"…" to the payload (for webhooks that require a secret).
secretPart = useSecret and secret != "" ? ',"secret":"' + secret + '"' : ""
buyMsg  = '{"action":"buy","symbol":"'  + symbol + '","volume":' + str.tostring(lots) + secretPart + '}'
sellMsg = '{"action":"sell","symbol":"' + symbol + '","volume":' + str.tostring(lots) + secretPart + '}'

// ── Fire ──
if goLong
    alert(buyMsg,  alert.freq_once_per_bar_close)
if goShort
    alert(sellMsg, alert.freq_once_per_bar_close)
