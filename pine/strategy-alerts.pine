//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// TickerAll — TradingView → MT4/MT5 alert bridge (STRATEGY template)
//
// A minimal EMA-cross strategy that emits TickerAll webhook JSON on each signal.
// Replace the signal logic with your own — only the alert() calls matter for the
// bridge. See https://github.com/TickerAll/tradingview-mt5-mt4
//
// HOW TO WIRE IT UP
//   1. Add this script to your chart and tune the inputs.
//   2. Create an alert on it. Condition: this strategy, "alert() function calls only".
//   3. Webhook URL: paste your TickerAll webhook URL.
//   4. Leave the alert Message empty — the alert() calls below carry the JSON.
// ─────────────────────────────────────────────────────────────────────────────
strategy("TickerAll Bridge — EMA cross", overlay = true,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100)

// ── Inputs ──
symbol    = input.string("BTCUSD", "Broker symbol")            // sent as "symbol"
lots      = input.float(0.10, "Lot size", minval = 0.01, step = 0.01)
fastLen   = input.int(9,  "Fast EMA")
slowLen   = input.int(21, "Slow EMA")
useSecret = input.bool(false, "Send a secret")
secret    = input.string("", "Secret (if your webhook requires one)")

// ── Signals (swap for your own) ──
fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
goLong  = ta.crossover(fast, slow)
goShort = ta.crossunder(fast, slow)

plot(fast, "Fast EMA", color.new(color.aqua, 0))
plot(slow, "Slow EMA", color.new(color.orange, 0))

// ── Build the webhook JSON ──
secretPart(bool on, string s) => on and s != "" ? ',"secret":"' + s + '"' : ""
buyMsg  = '{"action":"buy","symbol":"'  + symbol + '","volume":' + str.tostring(lots) + secretPart(useSecret, secret) + '}'
sellMsg = '{"action":"sell","symbol":"' + symbol + '","volume":' + str.tostring(lots) + secretPart(useSecret, secret) + '}'

// ── Fire ──
if goLong
    strategy.entry("long", strategy.long)
    alert(buyMsg,  alert.freq_once_per_bar_close)

if goShort
    strategy.entry("short", strategy.short)
    alert(sellMsg, alert.freq_once_per_bar_close)

// TIP: to close a position instead of flipping it, send
// {"action":"close","symbol":"..."} — or {"action":"close_all"} — from your exit.
